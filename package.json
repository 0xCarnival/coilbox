{
  "name": "coilbox",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Three.js game studio: author, play, and export standalone browser games.",
  "license": "MIT",
  "author": "0xCarnival",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xCarnival/coilbox.git"
  },
  "homepage": "https://github.com/0xCarnival/coilbox#readme",
  "bugs": {
    "url": "https://github.com/0xCarnival/coilbox/issues"
  },
  "keywords": [
    "threejs",
    "game-engine",
    "game-studio",
    "editor",
    "webgl",
    "box3d",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "tsx server/cli.ts dev",
    "studio": "tsx server/cli.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c oxlint.config.ts --deny-warnings src server tools tests",
    "test": "vitest run",
    "templates": "tsx tools/write-templates.ts",
    "probe-project": "tsx tools/write-probe-project.ts",
    "verify:stage0": "tsx tools/verify-stage0.ts",
    "verify:stage1": "tsx tools/verify-stage1.ts",
    "verify:stage2": "tsx tools/verify-stage2.ts",
    "fixtures": "tsx tools/write-fixtures.ts",
    "verify:stage3": "tsx tools/verify-stage3.ts",
    "games": "tsx tools/write-games.ts",
    "racer": "tsx tools/write-racer.ts",
    "verify:stage4": "tsx tools/verify-stage4.ts",
    "verify:stage5": "tsx tools/verify-stage5.ts",
    "verify": "tsx tools/verify-all.ts"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "box3d.js": "0.1.1",
    "lucide-react": "^1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@oxlint/plugins": "1.83.0",
    "@playwright/test": "1.63.0",
    "@stylexjs/stylex": "0.19.0",
    "@stylexjs/unplugin": "0.19.0",
    "@types/draco3d": "1.4.10",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "draco3d": "1.5.7",
    "meshoptimizer": "1.1.1",
    "oxlint": "1.83.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "unplugin": "3.3.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
