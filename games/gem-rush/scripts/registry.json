{
  "schemaVersion": 1,
  "behaviors": [
    {
      "id": "player.mover",
      "name": "Character Mover",
      "description": "Moves a kinematic body with WASD/arrow input, gravity, and optional jumping.",
      "properties": [
        {
          "key": "moveSpeed",
          "label": "Move speed",
          "type": "number",
          "default": 5,
          "min": 0,
          "max": 40,
          "step": 0.5,
          "group": "Movement"
        },
        {
          "key": "jumpStrength",
          "label": "Jump strength",
          "type": "number",
          "default": 7,
          "min": 0,
          "max": 30,
          "step": 0.5,
          "group": "Movement",
          "description": "Set to 0 to disable jumping."
        },
        {
          "key": "gravity",
          "label": "Gravity",
          "type": "number",
          "default": 20,
          "min": 0,
          "max": 80,
          "step": 1,
          "group": "Movement"
        },
        {
          "key": "turnSpeed",
          "label": "Turn speed",
          "type": "number",
          "default": 12,
          "min": 0,
          "max": 60,
          "step": 1,
          "group": "Movement",
          "description": "How quickly the character faces its movement direction, in radians per second."
        },
        {
          "key": "acceleration",
          "label": "Acceleration",
          "type": "number",
          "default": 40,
          "min": 1,
          "max": 200,
          "step": 1,
          "group": "Movement",
          "advanced": true
        },
        {
          "key": "groundCheckDistance",
          "label": "Ground check",
          "type": "number",
          "default": 0.35,
          "min": 0.05,
          "max": 2,
          "step": 0.05,
          "group": "Movement",
          "advanced": true
        },
        {
          "key": "spawnHeight",
          "label": "Spawn height",
          "type": "number",
          "default": 1,
          "min": 0,
          "max": 10,
          "step": 0.1,
          "group": "Movement",
          "advanced": true,
          "description": "Height above the authored position where the character starts."
        }
      ]
    },
    {
      "id": "camera.follow",
      "name": "Camera Follow",
      "description": "Keeps a camera behind and above a target, or at a fixed offset from it.",
      "properties": [
        {
          "key": "target",
          "label": "Target",
          "type": "entity",
          "default": null,
          "description": "The entity to follow. Defaults to the entity named \"Player\"."
        },
        {
          "key": "distance",
          "label": "Distance",
          "type": "number",
          "default": 8,
          "min": 0,
          "max": 40,
          "step": 0.5
        },
        {
          "key": "height",
          "label": "Height",
          "type": "number",
          "default": 5,
          "min": 0,
          "max": 30,
          "step": 0.5
        },
        {
          "key": "damping",
          "label": "Smoothing",
          "type": "number",
          "default": 0.12,
          "min": 0,
          "max": 2,
          "step": 0.02
        },
        {
          "key": "lookHeight",
          "label": "Look at height",
          "type": "number",
          "default": 1,
          "min": 0,
          "max": 5,
          "step": 0.1,
          "description": "Height above the target the camera aims at."
        },
        {
          "key": "fixed",
          "label": "Fixed world offset",
          "type": "boolean",
          "default": false,
          "description": "Keep a world-space offset instead of following behind the target."
        }
      ]
    },
    {
      "id": "game.collectible",
      "name": "Collectible",
      "description": "Adds to the score when the player touches it, then disappears. Needs a sensor collider.",
      "properties": [
        {
          "key": "value",
          "label": "Score value",
          "type": "number",
          "default": 1,
          "min": 0,
          "max": 100,
          "step": 1
        },
        {
          "key": "playerName",
          "label": "Player entity name",
          "type": "text",
          "default": "Player"
        },
        {
          "key": "hideOnCollect",
          "label": "Hide when collected",
          "type": "boolean",
          "default": true
        },
        {
          "key": "pickupRadius",
          "label": "Pickup radius",
          "type": "number",
          "default": 1.2,
          "min": 0.1,
          "max": 10,
          "step": 0.1,
          "advanced": true,
          "description": "Distance at which the pickup is collected even if no sensor event arrives."
        }
      ]
    },
    {
      "id": "game.exit-zone",
      "name": "Exit Zone",
      "description": "Wins the level when the player enters it with enough collectibles gathered.",
      "properties": [
        {
          "key": "playerName",
          "label": "Player entity name",
          "type": "text",
          "default": "Player"
        },
        {
          "key": "requiredScore",
          "label": "Required score",
          "type": "number",
          "default": 3,
          "min": 0,
          "max": 100,
          "step": 1,
          "description": "0 means the exit is always open."
        },
        {
          "key": "winMessage",
          "label": "Win message",
          "type": "text",
          "default": "You escaped!"
        },
        {
          "key": "triggerRadius",
          "label": "Trigger radius",
          "type": "number",
          "default": 1.8,
          "min": 0.2,
          "max": 20,
          "step": 0.1,
          "advanced": true,
          "description": "Distance at which the exit counts as reached without a sensor event."
        },
        {
          "key": "repeatable",
          "label": "Can trigger again",
          "type": "boolean",
          "default": false
        }
      ]
    },
    {
      "id": "game.rules",
      "name": "Game Rules",
      "description": "Watches score and time, shows the win or lose overlay, and handles restart.",
      "properties": [
        {
          "key": "scoreTarget",
          "label": "Score target",
          "type": "number",
          "default": 3,
          "min": 0,
          "max": 100,
          "step": 1
        },
        {
          "key": "timeLimit",
          "label": "Time limit (s)",
          "type": "number",
          "default": 0,
          "min": 0,
          "max": 3600,
          "step": 5,
          "description": "0 disables the time limit."
        },
        {
          "key": "nextScene",
          "label": "Next scene",
          "type": "text",
          "default": "",
          "description": "Scene to load after winning. Empty restarts the current scene."
        },
        {
          "key": "showStartOverlay",
          "label": "Show start overlay",
          "type": "boolean",
          "default": true
        },
        {
          "key": "allowRestartKey",
          "label": "Restart with R",
          "type": "boolean",
          "default": true
        }
      ]
    }
  ]
}
