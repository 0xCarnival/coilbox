{
  "schemaVersion": 1,
  "engineVersion": "0.1.0",
  "engineCompat": "0.1.0",
  "id": "neon-yomi",
  "name": "NEON YOMI",
  "description": "Anti-gravity combat racing over the drowned city. Two laps of the Yomi Loop, three rivals, three hulls \u2014 drift the air brakes, ride the boost pads, and survive the Plunge into the Kannon Spire.",
  "scenes": [
    {
      "id": "main",
      "name": "Neon Yomi",
      "path": "scenes/main.scene.json"
    }
  ],
  "startScene": "main",
  "assetManifest": "assets/manifest.json",
  "behaviorRegistry": "scripts/registry.json",
  "settings": {
    "physics": {
      "fixedTimeStep": 0.016666666666666666,
      "subStepCount": 2,
      "maxSubSteps": 4,
      "enableSleep": true,
      "hitEventThreshold": 1
    },
    "render": {
      "antialias": false,
      "shadows": false,
      "pixelRatioCap": 1,
      "toneMapping": "neutral",
      "exposure": 1.12
    },
    "initialGameState": {
      "raceState": "countdown",
      "laps": 2,
      "lap": "1 / 2",
      "place": "- / 4",
      "speed": 0,
      "boost": 100,
      "energy": 100,
      "shield": false,
      "weapon": "\u2014",
      "craft": "TENGU  \u00b7  interceptor",
      "raceTime": "0:00.00",
      "hudRace": "- / 4   \u00b7   LAP 1 / 2",
      "hudPilot": "TENGU  \u00b7  interceptor   \u00b7   0:00.00",
      "hudSystems": "ENERGY 100%   \u00b7   WEAPON \u2014",
      "hudBoost": "BOOST 100%   \u00b7   hold SHIFT",
      "hudCenter": "HULL: 1 \u00b7 2 \u00b7 3",
      "objective": "",
      "announce": "",
      "won": false,
      "lost": false
    },
    "hud": [
      {
        "type": "label",
        "id": "race-label",
        "text": "{value}",
        "bind": "hudRace",
        "position": "top-left",
        "color": "#ff4fa3",
        "size": 22
      },
      {
        "type": "label",
        "id": "center-label",
        "text": "{value}",
        "bind": "hudCenter",
        "position": "top-center",
        "color": "#4ff0e6",
        "size": 30
      },
      {
        "type": "label",
        "id": "pilot-label",
        "text": "{value}",
        "bind": "hudPilot",
        "position": "top-right",
        "color": "#9fb6d8",
        "size": 17
      },
      {
        "type": "label",
        "id": "systems-label",
        "text": "{value}",
        "bind": "hudSystems",
        "position": "bottom-left",
        "color": "#ffb347",
        "size": 18
      },
      {
        "type": "label",
        "id": "speed-label",
        "text": "{value} km/h",
        "bind": "speed",
        "position": "bottom-center",
        "color": "#f0f6ff",
        "size": 46
      },
      {
        "type": "label",
        "id": "boost-label",
        "text": "{value}",
        "bind": "hudBoost",
        "position": "bottom-right",
        "color": "#4ff0e6",
        "size": 18
      },
      {
        "type": "overlay",
        "id": "start-overlay",
        "kind": "start",
        "title": "NEON YOMI",
        "message": "The sea took Tokyo a hundred and fifty years ago. What is left is the Yomi Loop \u2014 maglev decks strung between the crowns of nine towers, and the Kannon Spire, which is dead, and which you will fall through twice.\n\nW / \u2191 thrust   \u00b7   S / \u2193 brake   \u00b7   A D / \u2190 \u2192 steer\nQ / E air brakes \u2014 hold one to drift, hold both to slam\nSHIFT boost (charges while you drift)   \u00b7   SPACE fire\n1 KITSUNE \u00b7 2 TENGU \u00b7 3 ONI \u2014 pick your hull\n\nTwo laps. Four craft. First across the Yomi line.",
        "actionLabel": "Launch",
        "action": "resume",
        "background": "#04070e",
        "color": "#f0f6ff"
      },
      {
        "type": "overlay",
        "id": "win-overlay",
        "kind": "win",
        "title": "FIRST ACROSS THE YOMI LINE",
        "message": "The loop is yours. Somewhere under all that black water, the old city is still lit up.",
        "actionLabel": "Race again",
        "action": "restart",
        "background": "#04070e",
        "color": "#4ff0e6"
      },
      {
        "type": "overlay",
        "id": "lose-overlay",
        "kind": "lose",
        "title": "RACE OVER",
        "message": "Off the podium. Take the boost pads, drift the spiral, and put a shockwave through whoever is ahead of you.",
        "actionLabel": "Restart",
        "action": "restart",
        "background": "#04070e",
        "color": "#ff4fa3"
      }
    ],
    "inputBindings": {
      "moveForward": [
        "KeyW",
        "ArrowUp"
      ],
      "moveBackward": [
        "KeyS",
        "ArrowDown"
      ],
      "moveLeft": [
        "KeyA",
        "ArrowLeft"
      ],
      "moveRight": [
        "KeyD",
        "ArrowRight"
      ],
      "airbrakeLeft": [
        "KeyQ"
      ],
      "airbrakeRight": [
        "KeyE"
      ],
      "boost": [
        "ShiftLeft",
        "ShiftRight"
      ],
      "fire": [
        "Space",
        "KeyF"
      ],
      "craft1": [
        "Digit1"
      ],
      "craft2": [
        "Digit2"
      ],
      "craft3": [
        "Digit3"
      ],
      "restart": [
        "KeyR"
      ]
    }
  }
}
